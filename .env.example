# 凭据示例（复制为 .env 后填入真实值，请勿提交）
JIRA_BASE_URL=https://jira.yourcompany.com
JIRA_USERNAME=your-username
JIRA_PASSWORD=your-password
# macOS 推荐把密码放入钥匙串，并用服务名替代上面的 JIRA_PASSWORD：
# JIRA_KEYCHAIN_SERVICE=jira-server-mcp:jira.yourcompany.com
# 8.14+ 可改用 PAT（设置后优先于账号密码）：
# JIRA_TOKEN=your-personal-access-token
# 公司内部 CA 证书文件路径（如需要）：
# JIRA_CA_BUNDLE=/path/to/company-ca.pem
JIRA_SSL_VERIFY=true
JIRA_TIMEOUT=30
